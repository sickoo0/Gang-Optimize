{
  "name": "bytebase-gang-optimizer",
  "version": "0.1.0",
  "private": true,
  "description": "Development and test tools for the BYTEBASE Illustrator CEP panel",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "benchmark:packing": "node scripts/packing-comparison.cjs",
    "test:illustrator:packing": "node scripts/illustrator-packing-check.cjs",
    "test:illustrator:production": "node scripts/illustrator-production-check.cjs",
    "test:browser": "node scripts/browser-preview.mjs",
    "test:all": "npm test && npm run test:browser",
    "debug:cep": "node scripts/cep-debug.mjs",
    "debug:cep:calculate": "node scripts/cep-debug.mjs --calculate"
  },
  "devDependencies": {
    "pdf-lib": "1.17.1",
    "playwright": "^1.58.2"
  }
}
